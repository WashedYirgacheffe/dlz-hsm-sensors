# ---------------------------------------------------------------------------
# Public site settings (safe to expose — these are inlined at build time)
# ---------------------------------------------------------------------------

# Canonical origin. Must be the production domain, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://hsmsensors.com

# Where enquiry notifications and "email us" links are sent.
NEXT_PUBLIC_SALES_EMAIL=157583564@qq.com

# International format, digits only, no plus sign. Used for the wa.me link.
NEXT_PUBLIC_WHATSAPP=8613003936813

# Optional. Blank hides the corresponding link.
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_YOUTUBE=

# ---------------------------------------------------------------------------
# Server-only secrets — never prefix these with NEXT_PUBLIC_
# ---------------------------------------------------------------------------

# Inquiry storage. Create a Supabase project, run the SQL in docs/inquiries.sql,
# then paste the project URL and the service-role key here.
# Without these the site still runs: submissions are held in memory and lost
# on restart, and /admin/inquiries shows a warning.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email notification (Resend). Resend requires the sending domain to be
# verified before it will deliver to arbitrary recipients.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=quotes@hsmsensors.com

# Comma-separated list of internal recipients for new enquiries.
# Defaults to NEXT_PUBLIC_SALES_EMAIL when blank.
INQUIRY_NOTIFY_EMAIL=

# WhatsApp Cloud API — internal alert only, not sent to the buyer.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_NUMBER=

# /admin/inquiries gate. Minimum 12 characters. Use a password manager.
ADMIN_PASSWORD=

# Optional. Signs the admin session cookie. If blank, ADMIN_PASSWORD is used,
# which means changing the password also signs out every session.
ADMIN_SECRET=
